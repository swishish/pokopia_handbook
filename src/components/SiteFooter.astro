---
import site from "../data/site.json";
---

<footer class="site-footer">
  <div class="wrap">
    <p>{site.disclaimer_tc}</p>
    <p class="muted">{site.support_note_tc}</p>
    <div class="footer-meta">
      <span>資料版本 {site.game_version} · {site.updated}</span>
      <span class="muted">圖鑑圖：PokeAPI HOME；屬性圖示 MIT；口味／棲息／雲島示意為本站自繪</span>
      <a href="/about/">關於與來源政策</a>
      {site.report_mailto ? <a href={site.report_mailto}>回報錯誤</a> : <span class="muted">回報管道預留</span>}
    </div>
  </div>
</footer>
