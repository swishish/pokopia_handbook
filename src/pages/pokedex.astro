---
import BaseLayout from "../layouts/BaseLayout.astro";
import VersionBadge from "../components/VersionBadge.astro";
import ConfidenceBadge from "../components/ConfidenceBadge.astro";
import pokedex from "../data/pokedex.json";

const WATER_FAVS = new Set(["lots-of-water", "ocean-vibes"]);

function habitatId(mon: { habitat?: string }) {
  return String(mon.habitat ?? "").toLowerCase();
}

function waterLabels(mon: { favorites: string[]; favorites_tc: string[] }) {
  return mon.favorites
    .map((id, index) => ({ id, label: mon.favorites_tc[index] }))
    .filter((item) => WATER_FAVS.has(item.id));
}
---

<BaseLayout title="圖鑑" description="依屬性、口味、棲息與喜好類篩選 Pokopia 種族。種族中文為台灣官方譯名。">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">識別用 · 繁中官方譯名</p>
      <h1>圖鑑</h1>
      <p class="lead">
        共 {pokedex.count} 筆。用屬性、喜歡的口味、棲息環境與喜好類篩。種族中文對台灣寶可夢官方網站圖鑑。
      </p>
      <VersionBadge updated={pokedex.updated} />
      <details class="src-note">
        <summary>資料來源與圖示說明</summary>
        <p class="muted">{pokedex.note_tc} 口味與棲息小標為本站自繪，不是其他粉絲站的原畫。</p>
      </details>
    </header>

    <div class="pokedex-filters">
      <label>
        <span class="muted">搜尋名稱或全國／本篇編號</span>
        <input class="search-input" id="dex-q" type="search" placeholder="例如：水君、025、Pikachu" autocomplete="off" />
      </label>

      <fieldset class="filter-set">
        <legend>屬性 <span class="muted">可多選，符合其中一種即可</span></legend>
        <div class="chips" id="type-chips">
          {
            pokedex.types.map((type) => (
              <button class="chip chip-with-icon" type="button" data-filter="type" data-value={type.id} aria-pressed="false">
                <img src={`/icons/types/${type.id}.svg`} alt="" width="22" height="22" />
                {type.name_tc}
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="filter-set">
        <legend>喜歡的口味 <span class="muted">對齊站內食物頁：甜／酸／辣／苦／澀</span></legend>
        <div class="chips" id="flavor-chips">
          {
            pokedex.flavors.map((flavor) => (
              <button class="chip chip-with-icon" type="button" data-filter="flavor" data-value={flavor.id} aria-pressed="false">
                <img src={`/icons/flavors/${flavor.id}.svg`} alt="" width="22" height="22" />
                {flavor.name_tc}
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="filter-set">
        <legend>棲息環境 <span class="muted">明亮、潮溼、陰暗等；與「很多水」分開</span></legend>
        <div class="chips" id="habitat-chips">
          {
            (pokedex.habitats ?? []).map((habitat) => (
              <button class="chip chip-with-icon" type="button" data-filter="habitat" data-value={habitat.id} aria-pressed="false">
                <img src={`/icons/habitats/${habitat.id}.svg`} alt="" width="22" height="22" />
                {habitat.name_tc}
              </button>
            ))
          }
        </div>
      </fieldset>

      <details class="fav-panel">
        <summary>喜好類（傢俬／活動）· 與口味、棲息分開</summary>
        <div class="chips" id="fav-chips">
          {
            pokedex.favorite_categories.map((fav) => (
              <button class={`chip${WATER_FAVS.has(fav.id) ? " chip-with-icon" : ""}`} type="button" data-filter="fav" data-value={fav.id} aria-pressed="false">
                {WATER_FAVS.has(fav.id) ? <img src="/icons/habitats/water.svg" alt="" width="22" height="22" /> : null}
                {fav.name_tc}
              </button>
            ))
          }
        </div>
      </details>
    </div>

    <p id="dex-count" class="muted" aria-live="polite"></p>
    <div id="dex-empty" class="empty" hidden>沒有符合的種族。少選幾個篩選，或清空搜尋。</div>

    <div class="pokedex-grid" id="dex-grid">
      {
        pokedex.species.map((mon) => (
          <article
            class="dex-card"
            data-id={mon.id}
            data-tc={mon.name_tc}
            data-en={mon.name_en}
            data-jp={mon.name_jp}
            data-dex={String(mon.dex)}
            data-nat={String(mon.national_id)}
            data-types={mon.type_ids.join(" ")}
            data-flavor={mon.flavor_id}
            data-habitat-id={habitatId(mon)}
            data-favs={mon.favorites.join(" ")}
            data-fav-labels={mon.favorites_tc.join("、")}
            data-habitat={mon.habitat_tc}
            data-location={mon.location_tc}
            data-portal={mon.portal_url}
            data-source={mon.source_url}
            data-attr={mon.image_attr_tc}
            data-unique={mon.pokopia_unique ? "1" : ""}
          >
            <button class="dex-open" type="button" data-open={mon.id} aria-label={`開啟 ${mon.name_tc} 詳情`}>
              {mon.image ? (
                <img src={mon.image} alt="" width="96" height="96" loading="lazy" />
              ) : (
                <span class="thumb-ph">無圖</span>
              )}
              <span class="dex-no">#{String(mon.dex).padStart(3, "0")}</span>
              <strong>{mon.name_tc}</strong>
            </button>
            <div class="dex-meta">
              <div class="type-row">
                {mon.types.map((type, index) => (
                  <span class={`type-pill type-${mon.type_ids[index]}`}>
                    <img src={`/icons/types/${mon.type_ids[index]}.svg`} alt="" width="18" height="18" />
                    {type}
                  </span>
                ))}
              </div>
              <div class="pref-row">
                {mon.flavor_id ? (
                  <span class="pref-chip flavor-chip">
                    <img src={`/icons/flavors/${mon.flavor_id}.svg`} alt="" width="18" height="18" />
                    {mon.flavor_tc}
                  </span>
                ) : (
                  <span class="muted">口味未標</span>
                )}
                {mon.habitat_tc ? (
                  <span class="pref-chip habitat-chip">
                    <img src={`/icons/habitats/${habitatId(mon)}.svg`} alt="" width="18" height="18" />
                    {mon.habitat_tc}
                  </span>
                ) : null}
                {waterLabels(mon).map((item) => (
                  <span class="pref-chip env-chip">
                    <img src="/icons/habitats/water.svg" alt="" width="18" height="18" />
                    {item.label}
                  </span>
                ))}
              </div>
              <div class="fav-row">
                {mon.favorites_tc
                  .filter((_, index) => !WATER_FAVS.has(mon.favorites[index]))
                  .slice(0, 3)
                  .map((fav) => (
                    <span class="mini-chip mini-fav">{fav}</span>
                  ))}
              </div>
              <ConfidenceBadge value={mon.confidence} />
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <dialog class="dex-dialog" id="dex-dialog">
    <div class="dex-dialog-body">
      <button class="button" type="button" id="dex-close">關閉</button>
      <div id="dex-dialog-content"></div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .src-note {
    margin: 0.5rem 0 0;
    max-width: 42rem;
  }
  .src-note summary {
    cursor: pointer;
    min-height: 36px;
    display: flex;
    align-items: center;
    font-weight: 700;
  }
  .pokedex-filters {
    margin: 0 0 1rem;
    padding: 0 0 0.75rem;
    border-bottom: 2px solid var(--ink);
  }
  .filter-set {
    margin: 0.55rem 0 0;
    padding: 0;
    border: 0;
  }
  .filter-set legend {
    font-weight: 800;
    margin-bottom: 0.35rem;
  }
  .chip-with-icon {
    gap: 0.35rem;
    padding-inline: 0.5rem 0.75rem;
  }
  .chip-with-icon img {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
  }
  .fav-panel {
    margin-top: 0.7rem;
    border: 2px solid var(--ink);
    background: var(--paper-deep);
    box-shadow: var(--shadow-sm);
  }
  .fav-panel summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    font-weight: 800;
  }
  .fav-panel .chips {
    padding: 0 0.75rem 0.75rem;
  }
  .pokedex-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
  }
  .dex-card {
    border: 2px solid var(--ink);
    background: #fffdf8;
    box-shadow: var(--shadow-sm);
    padding: 0.7rem;
    display: grid;
    gap: 0.45rem;
  }
  .dex-open {
    display: grid;
    grid-template-columns: 88px 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.65rem;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .dex-open img,
  .dex-open .thumb-ph {
    grid-row: 1 / span 2;
    width: 88px;
    height: 88px;
    object-fit: contain;
    background: var(--paper-deep);
    border: 2px solid var(--ink);
  }
  .dex-no {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--ink-muted);
  }
  .type-row,
  .pref-row,
  .fav-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .type-pill,
  .pref-chip,
  .mini-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    min-height: 1.7rem;
    padding: 0.08rem 0.42rem 0.08rem 0.22rem;
    border: 2px solid var(--ink);
    font-size: 0.78rem;
    font-weight: 800;
    background: var(--paper);
  }
  .type-pill img,
  .pref-chip img {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }
  .mini-chip {
    padding: 0.05rem 0.4rem;
    font-weight: 600;
  }
  .mini-fav {
    background: var(--paper-deep);
  }
  .flavor-chip {
    background: #f6e6d4;
  }
  .habitat-chip {
    background: #e8efe4;
  }
  .env-chip {
    background: #dce8f3;
  }
  .type-fire { background: #f3d4c8; }
  .type-water { background: #d4e4f3; }
  .type-grass { background: #d9eddf; }
  .type-electric { background: #f3ebc8; }
  .type-ice { background: #dcecf3; }
  .type-fighting { background: #efd4c4; }
  .type-poison { background: #e6d4ef; }
  .type-ground { background: #eadcc8; }
  .type-flying { background: #dde4f3; }
  .type-psychic { background: #f3d4e4; }
  .type-bug { background: #e4edc8; }
  .type-rock { background: #e4dcc8; }
  .type-ghost { background: #ddd4e8; }
  .type-dragon { background: #d4d8f0; }
  .type-dark { background: #e4dcd4; }
  .type-steel { background: #e0e4e8; }
  .type-fairy { background: #f3dce8; }
  .type-normal { background: #eeeae0; }
  .dex-dialog {
    border: 2px solid var(--ink);
    box-shadow: var(--shadow);
    background: var(--paper);
    width: min(32rem, 100% - 1.5rem);
    padding: 0;
  }
  .dex-dialog::backdrop {
    background: rgb(26 26 26 / 0.45);
  }
  .dex-dialog-body {
    padding: 1rem;
  }
  .dex-dialog-body img.dialog-thumb {
    width: 160px;
    height: 160px;
    object-fit: contain;
    border: 2px solid var(--ink);
    background: var(--paper-deep);
  }
  @media (max-width: 719px) {
    .dex-open {
      grid-template-columns: 72px 1fr;
    }
    .dex-open img,
    .dex-open .thumb-ph {
      width: 72px;
      height: 72px;
    }
  }
  @media (min-width: 720px) {
    .pokedex-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .pokedex-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>("#dex-grid .dex-card"));
  const search = document.querySelector<HTMLInputElement>("#dex-q");
  const empty = document.querySelector<HTMLElement>("#dex-empty");
  const count = document.querySelector<HTMLElement>("#dex-count");
  const dialog = document.querySelector<HTMLDialogElement>("#dex-dialog");
  const dialogBody = document.querySelector<HTMLElement>("#dex-dialog-content");
  const closeBtn = document.querySelector<HTMLButtonElement>("#dex-close");

  const selected = {
    type: new Set<string>(),
    flavor: new Set<string>(),
    habitat: new Set<string>(),
    fav: new Set<string>(),
  };

  function toggle(group: "type" | "flavor" | "habitat" | "fav", value: string, button: HTMLButtonElement) {
    if (selected[group].has(value)) selected[group].delete(value);
    else selected[group].add(value);
    button.setAttribute("aria-pressed", String(selected[group].has(value)));
    apply();
  }

  function apply() {
    const query = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const types = (card.dataset.types ?? "").split(" ").filter(Boolean);
      const favs = (card.dataset.favs ?? "").split(" ").filter(Boolean);
      const matchType = selected.type.size === 0 || types.some((id) => selected.type.has(id));
      const matchFlavor = selected.flavor.size === 0 || selected.flavor.has(card.dataset.flavor ?? "");
      const matchHabitat = selected.habitat.size === 0 || selected.habitat.has(card.dataset.habitatId ?? "");
      const matchFav = selected.fav.size === 0 || favs.some((id) => selected.fav.has(id));
      const hay = `${card.dataset.tc} ${card.dataset.en} ${card.dataset.jp} ${card.dataset.dex} ${card.dataset.nat}`.toLowerCase();
      const matchQuery = !query || hay.includes(query) || (card.dataset.dex ?? "").padStart(3, "0").includes(query.replace("#", ""));
      const show = matchType && matchFlavor && matchHabitat && matchFav && matchQuery;
      card.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible !== 0;
    if (count) count.textContent = `顯示 ${visible}／${cards.length} 筆`;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
    button.addEventListener("click", () => {
      const group = button.dataset.filter as "type" | "flavor" | "habitat" | "fav";
      const value = button.dataset.value ?? "";
      toggle(group, value, button);
    });
  });

  search?.addEventListener("input", apply);

  function openCard(card: HTMLElement) {
    if (!dialog || !dialogBody) return;
    const img = card.querySelector(".dex-open img")?.getAttribute("src") ?? "";
    const types = [...card.querySelectorAll(".type-pill")].map((el) => el.outerHTML).join(" ");
    const prefs = [...card.querySelectorAll(".pref-chip")].map((el) => el.outerHTML).join(" ") || "未標";
    const furniture = [...card.querySelectorAll(".mini-fav")].map((el) => el.outerHTML).join(" ") || "未標";
    dialogBody.innerHTML = `
      <p class="kicker">${card.dataset.unique ? "本作用例" : "種族"}</p>
      <p class="dex-no">#${(card.dataset.dex ?? "").padStart(3, "0")} · 全國 ${card.dataset.nat}</p>
      <h2 style="margin:.2rem 0 .5rem">${card.dataset.tc}</h2>
      <p class="muted">${card.dataset.jp} · ${card.dataset.en}</p>
      ${img ? `<img class="dialog-thumb" src="${img}" alt="" width="160" height="160">` : ""}
      <p>${types}</p>
      <p><strong>口味／棲息</strong></p>
      <p class="pref-row">${prefs}</p>
      <p><strong>喜好類</strong></p>
      <p class="fav-row">${furniture}</p>
      <p><strong>主要地區</strong>　${card.dataset.location ?? "—"}</p>
      <p class="muted">${card.dataset.attr ?? ""}</p>
      <p class="button-row">
        ${card.dataset.portal ? `<a class="button button-solid" href="${card.dataset.portal}" rel="noopener noreferrer">台灣官方圖鑑</a>` : ""}
        ${card.dataset.source ? `<a class="button" href="${card.dataset.source}" rel="noopener noreferrer">Serebii</a>` : ""}
      </p>
    `;
    dialog.showModal();
  }

  document.querySelector("#dex-grid")?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>("[data-open]");
    if (!button) return;
    const card = button.closest<HTMLElement>(".dex-card");
    if (card) openCard(card);
  });
  closeBtn?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  apply();
</script>
