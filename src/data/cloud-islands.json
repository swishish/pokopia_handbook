{
  "title_tc": "雲島地址",
  "game_version": "2.0.1",
  "updated": "2026-10-13",
  "last_checked": "2026-10-13",
  "kicker_tc": "虛擬模式 · 地址速查",
  "lead_tc": "用神秘護目鏡進虛擬模式，參觀官方與精選社群雲島。地址寫成四加四、中間空一格。這頁是連線參觀用的雲島，不是圖鑑棲息地「雲之島」，也不是每日重置的夢島。",
  "howto_title_tc": "怎麼去",
  "howto": [
    "把環境等級升到 3（荒野／乾巴巴荒野的寶可夢中心一帶）。",
    "到 PC 商店購買「神秘護目鏡」。",
    "打開背包使用護目鏡。",
    "輸入雲島地址。",
    "以虛擬模式參觀。需 Nintendo Switch Online。"
  ],
  "howto_notes_tc": [
    "虛擬模式不會改動對方島。",
    "社群島可能隨時關閉、改內容或失效；進遊戲前再核一次。"
  ],
  "disclaimer_tc": "本頁是非商業粉絲百科整理，不是任天堂或寶可夢公司官方目錄。地址會變。標「社群」的不是 Nintendo／TPC 官方島。已結束的只作紀錄，不要當現役地址。",
  "code_note_tc": "地址格式與 pokopiaguide、任天堂公開稿一致：四碼＋空格＋四碼。部分社群文用連字號或連寫，本站一律空格。",
  "preview_note_tc": "卡片縮圖先用攻略站／社群公開截圖佔位。圖下「資料來源」的編號連到原頁。之後可換成自己的 Switch 截圖，JSON 的 preview 與 preview_sources 一併改。",
  "sources": [
    {
